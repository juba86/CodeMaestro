{
  "name": "code-maestro",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted control plane to forge structured prompts and conduct a fleet of AI coding agents (Claude Code, Gemini CLI, local models) on a real working directory — with an approval gate, sandbox, and multi-model orchestrator.",
  "license": "AGPL-3.0-or-later",
  "author": "Jurak Bahrambäk",
  "homepage": "https://github.com/Muchel187/CodeMaestro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muchel187/CodeMaestro.git"
  },
  "bugs": {
    "url": "https://github.com/Muchel187/CodeMaestro/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "prompt-engineering",
    "claude",
    "gemini",
    "ollama",
    "coding-agent",
    "agent-orchestration",
    "self-hosted",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:tailnet": "next start -H 127.0.0.1 --keepAliveTimeout 95000",
    "dev:tailnet": "next dev -H 127.0.0.1",
    "tailscale:up": "bash scripts/tailscale-https.sh up",
    "tailscale:status": "bash scripts/tailscale-https.sh status",
    "tailscale:down": "bash scripts/tailscale-https.sh down",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@google/genai": "^1.43.0",
    "@libsql/client": "^0.17.0",
    "@pixi/react": "^8.0.5",
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/adapter-libsql": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "pixi.js": "^8.19.0",
    "prisma": "^7.4.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
