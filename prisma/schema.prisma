generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Prompt {
  id          String          @id @default(cuid())
  title       String
  description String          @default("")
  content     String          // XML string
  structured  String          @default("{}") // JSON string of structured data
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  versions    PromptVersion[]
  tags        PromptTag[]
  testResults TestResult[]
  testCases   TestCase[]

  @@index([title])
  @@index([updatedAt])
}

model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String
  version   Int
  content   String
  structured String  @default("{}")
  changelog String   @default("")
  createdAt DateTime @default(now())

  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@index([createdAt])
}

model PromptTag {
  id       String @id @default(cuid())
  promptId String
  tag      String

  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, tag])
  @@index([tag])
}

model TestResult {
  id           String   @id @default(cuid())
  promptId     String
  provider     String   // "claude" | "gemini" | "ollama"
  model        String
  input        String
  output       String
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([createdAt])
}

// User-defined evaluation cases for a prompt (regression testing).
model TestCase {
  id        String   @id @default(cuid())
  promptId  String
  name      String   @default("")
  input     String   @default("")
  matchType String   @default("contains") // "contains" | "regex" | "equals" | "icontains"
  expected  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
}

// RAG knowledge base: a source document split into embedded chunks.
model KnowledgeDoc {
  id        String           @id @default(cuid())
  title     String
  source    String           @default("") // url/filename/manual
  createdAt DateTime         @default(now())

  chunks    KnowledgeChunk[]

  @@index([createdAt])
}

model KnowledgeChunk {
  id        String   @id @default(cuid())
  docId     String
  idx       Int
  content   String
  embedding String   // JSON array of floats
  model     String   @default("") // embedding model used
  createdAt DateTime @default(now())

  doc       KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
}

model Template {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  category    String   @default("general")
  content     String   // XML template with {{PLACEHOLDERS}}
  structured  String   @default("{}") // JSON of structured template data
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([slug])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON string

  @@index([key])
}

// Embedded code-assistant sessions (Claude Code / gemini-cli driven via -p).
model AssistantSession {
  id             String   @id @default(cuid())
  externalId     String?  @unique // session_id from the CLI (for --resume)
  provider       String   @default("claude") // "claude" | "gemini"
  model          String   @default("")
  title          String   @default("")
  cwd            String                    // working directory (whitelisted)
  permissionMode String   @default("default")
  allowedTools   String   @default("Read,Grep,Glob") // CSV
  approvalMode   String   @default("off") // off | edits | all
  sandbox        Boolean  @default(false)
  status         String   @default("idle") // idle|running|error|done
  totalCostUsd   Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       AssistantMessage[]

  @@index([createdAt])
  // The session list and the activity snapshot order by updatedAt.
  @@index([updatedAt])
}

model AssistantMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // user | assistant | tool_use | tool_result | system | error
  content   String
  meta      String   @default("{}") // JSON: tokens, tool name, cost, etc.
  createdAt DateTime @default(now())

  session   AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  // Transcripts are read as WHERE sessionId ORDER BY createdAt: no temp sort.
  @@index([sessionId, createdAt])
}
