# --- Database ---
# SQLite database file path
DATABASE_URL="file:./dev.db"

# --- AI Provider API Keys (all optional) ---
# Can also be set in the in-app Settings page. These serve as server-side
# fallbacks when no client-side key is configured. Not needed for Ollama, or
# for Claude/Gemini when using CLI logins.
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
# Used by the Gemini CLI worker when not authenticated via Google login (OAuth).
GEMINI_API_KEY=""

# --- Ollama (local models, optional) ---
# Endpoint of the local Ollama daemon.
OLLAMA_BASE_URL="http://localhost:11434"
# Embedding model used by the Knowledge Base (RAG).
OLLAMA_EMBED_MODEL="bge-m3:latest"
# Ollama Cloud (hosted models at ollama.com) API key. Optional server-side
# fallback — can also be entered in Settings → Provider "Ollama Cloud".
OLLAMA_API_KEY=""

# --- Code Assistant sandbox ---
# Colon-separated directories the Code Assistant / Orchestrator may operate in.
# Defaults to the parent of the app directory if unset. Keep this tight.
# ASSISTANT_ALLOWED_DIRS="/path/to/projects"

# --- Telegram fallback (optional) ---
# The Telegram bridge is configured entirely in the PWA (Settings → Telegram):
# bot token, allowed chat IDs, working directory, permission/approval mode.
# Nothing needs to be set here. The PWA stays the primary interface (Tailscale);
# Telegram is an optional way to drive the assistant when you are away from it.
