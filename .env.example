# --- Database ---
# SQLite database file path
DATABASE_URL="file:./dev.db"

# --- AI Provider API Keys (all optional) ---
# Can also be set in the in-app Settings page. These serve as server-side
# fallbacks when no client-side key is configured. Not needed for Ollama, or
# for Claude/Gemini when using CLI logins.
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
# Used by the Gemini CLI worker when not authenticated via Google login (OAuth).
GEMINI_API_KEY=""

# --- Ollama (local models, optional) ---
# Endpoint of the local Ollama daemon.
OLLAMA_BASE_URL="http://localhost:11434"
# Embedding model used by the Knowledge Base (RAG).
OLLAMA_EMBED_MODEL="bge-m3:latest"
# Ollama Cloud (hosted models at ollama.com) API key. Optional server-side
# fallback — can also be entered in Settings → Provider "Ollama Cloud".
OLLAMA_API_KEY=""

# --- Code Assistant sandbox ---
# Colon-separated directories the Code Assistant / Orchestrator may operate in.
# Defaults to the parent of the app directory if unset. Keep this tight.
# ASSISTANT_ALLOWED_DIRS="/path/to/projects"

# --- Telegram fallback (optional) ---
# The Telegram bridge is configured entirely in the PWA (Settings → Telegram):
# bot token, allowed chat IDs, working directory, permission/approval mode.
# Nothing needs to be set here. The PWA stays the primary interface (Tailscale);
# Telegram is an optional way to drive the assistant when you are away from it.

# --- HTTPS on the tailnet / PWA (see docs/TAILSCALE_HTTPS.md) ---
# Recommended: `npm run start:tailnet` (binds 127.0.0.1) + `npm run tailscale:up`
# (tailscale serve --bg --https=443 http://127.0.0.1:$PORT).
# PORT=3000
# Optional identity allowlist for all /api routes: comma-separated Tailscale
# login names ("*" = any tailnet user). Uses the Tailscale-User-Login header set
# by `tailscale serve`; only trustworthy while the app listens on 127.0.0.1.
# Tagged devices carry no identity and are rejected while this is set.
# CODEMAESTRO_TAILSCALE_USERS="you@example.com"
# Extra origins allowed to send state-changing API requests (CSRF guard);
# the app's own origin is always allowed.
# CODEMAESTRO_ALLOWED_ORIGINS="https://codemaestro.example.com"
# Web Push VAPID contact: mailto: or https: (Apple rejects localhost contacts).
# Defaults to the project homepage.
# CODEMAESTRO_PUSH_SUBJECT="mailto:you@example.com"
# 1 = expose Code Assistant dev servers as https://<machine>.<tailnet>.ts.net:<port>
# via `tailscale serve` (avoids mixed-content links when the app runs on HTTPS).
# CODEMAESTRO_DEV_TAILSCALE_SERVE=1
# Extra hostnames `npm run dev` accepts HMR from (tailnet/LAN IPs, *.ts.net,
# *.local and this machine's hostname are already allowed).
# CODEMAESTRO_DEV_ORIGINS="devbox,devbox.fritz.box"
# Base URL the CLI approval hook calls back (default http://127.0.0.1:$PORT).
# CODEMAESTRO_INTERNAL_URL="http://127.0.0.1:3000"
# Seconds an approval/question waits before it is auto-denied (default 1800, min 30).
# ASSISTANT_APPROVAL_TIMEOUT_SEC=1800

# --- GitHub (Settings → GitHub) ---
# Secrets stored in the database (GitHub token, …) are encrypted with AES-256-GCM.
# Without CODEMAESTRO_SECRET a random key is created at .codemaestro/secret.key —
# back it up together with the database, or set a stable secret here.
# CODEMAESTRO_SECRET="a-long-random-string"
# Optional server-wide OAuth App client ID for "Mit GitHub verbinden" (device
# flow; enable "Device Flow" in the OAuth App). Can also be entered in Settings.
# GITHUB_OAUTH_CLIENT_ID="Ov23li..."

# --- Local models via pi (Settings → Lokale Modelle) ---
# Install the pi coding agent on the server (Node >= 22.19):
#   npm install -g --ignore-scripts @earendil-works/pi-coding-agent
# Every model on OLLAMA_BASE_URL is registered automatically (CodeMaestro keeps
# its own pi config in .codemaestro/pi-agent — ~/.pi is not touched).
# PI_BIN="/usr/local/bin/pi"
# Context window Ollama really runs with when a model has no num_ctx (set it to
# the server's OLLAMA_CONTEXT_LENGTH; default assumption 32768).
# PI_OLLAMA_CONTEXT_LENGTH=65536
# CODEMAESTRO_PI_AGENT_DIR="/var/lib/codemaestro/pi-agent"
